# Copie este arquivo para ".env" (mesma pasta) e preencha valores reais antes de rodar
# "docker compose up -d". O ".env" real NUNCA deve ser commitado no git (ja esta no .gitignore).

# Senha do usuario postgres dentro do container do banco (defina uma senha forte).
DB_PASSWORD=troque-esta-senha

# Segredo usado para assinar os tokens JWT de login - precisa ter pelo menos 32 caracteres
# e ser dificil de adivinhar. Gere um novo, por exemplo com:
#   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-verdade-com-pelo-menos-32-bytes
